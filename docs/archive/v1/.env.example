# ==========================================
# RankUno 1Stop Solution — Environment Config
# ==========================================

# System Mode
ENV=development                            # development / staging / production
LOG_LEVEL=INFO

# LLM Provider Configuration
LLM_PROVIDER=OPENAI                        # Options: OPENAI, CLAUDE, GEMINI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database Configurations
POSTGRES_USER=rankuno
POSTGRES_PASSWORD=rankuno_secret
POSTGRES_DB=onestop_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333

REDIS_HOST=redis
REDIS_PORT=6379

# Google Workspace SSO & Drive API Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J
EXCEL_REGISTRY_FILENAME=Utilities_Master.xlsx

# Compliance Alert Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@rankuno.com
SMTP_PASSWORD=app-specific-password
SMTP_FROM_EMAIL=onestop-alerts@rankuno.com
