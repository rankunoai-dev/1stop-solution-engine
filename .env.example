# RankUno 1Stop: environment variables (docs/ARCHITECTURE.md §13).
# Copy to .env for local development. Never commit .env.
# Each variable is read only through get_settings(); secrets are SecretStr.

# --- Mode -------------------------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO

# --- Database (local Docker Compose, or Supabase pooler in session mode) -----
# Local dev:      postgresql+psycopg://onestop:onestop_dev@localhost:5432/onestop
# Supabase (prod): postgresql+psycopg://[user]:[password]@[host]:5432/postgres
DATABASE_URL=

# --- Sessions and access ------------------------------------------------------
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
# ALLOWED_EMAILS: comma-separated list of staff emails permitted to log in.
# Leave blank during development to allow any email (auth/allowlist check is skipped).
ALLOWED_EMAILS=

# --- Email: Gmail SMTP with an app password during testing (ADR 0006) --------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Sources -----------------------------------------------------------------
# GITHUB_TOKEN: fine-grained personal access token, read-only, selected repos.
GITHUB_TOKEN=
# GDRIVE_SERVICE_ACCOUNT_JSON_B64: base64-encoded service-account JSON; never commit the file.
GDRIVE_SERVICE_ACCOUNT_JSON_B64=
GDRIVE_REGISTRY_FOLDER_ID=
GDRIVE_REGISTRY_FILE_NAME=

# --- LLM (ADR 0008): ollama in development; a paid no-training tier for the pilot
LLM_PROVIDER=ollama                # ollama | anthropic | gemini
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Embeddings (ADR 0002) ---------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Spend caps in USD (ADR 0005); editable later in the admin UI ------------
SPEND_CAP_DAY_USD=1.00
SPEND_CAP_MONTH_USD=10.00

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
